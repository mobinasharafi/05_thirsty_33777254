<!doctype html>
<html>
<head>
  <title>Register — <%= shopName %></title>
  <style>
    body {
      background:#ffdfeb;
      font-family: "Georgia", serif;
      display:flex;
      justify-content:center;
      align-items:center;
      height:100vh;
      margin:0;
      text-align:center;
      color:#4d2b10;
    }
    h1 {
      font-size:32px;
      margin-bottom:12px;
      letter-spacing:1px;
      color:#4d132d;
    }
    .card {
      background:#fff1f7;
      border:2px solid #4d132d;
      padding:24px;
      width:300px;
      border-radius:10px;
      box-shadow:0 4px 10px rgba(0,0,0,0.12);
    }
    input {
      width:90%;
      padding:8px;
      margin:8px 0;
      border-radius:6px;
      border:1px solid #b77c93;
      background:#ffffff;
    }
    button {
      margin-top:12px;
      background:#6e1c34;
      color:#fff;
      border:none;
      padding:10px 18px;
      border-radius:6px;
      cursor:pointer;
      font-size:14px;
    }
    a {
      display:block;
      margin-top:14px;
      color:#1a3c73;
      text-decoration:underline;
      font-size:13px;
    }
    button:hover { opacity:0.85; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Sign Up</h1>
    <form action="/registered" method="POST">
      <input id="first" type="text" name="first" placeholder="First name" required>
      <input id="last" type="text" name="last" placeholder="Last name" required>
      <input id="username" type="text" name="username" placeholder="Username" required>
      <input type="email" name="email" placeholder="Email" required pattern="^[^@\s]+@[^@\s]+\.[^@\s]+$">
      <button type="submit">Join Us</button>
    </form>
    <a href="/">⬅ Back to Home</a>
  </div>
</body>
</html>

